{{- $list := slice -}}
{{- range .Site.Params.nav -}}
  {{- $list = $list | append (dict "title" .name "url" (.url | relURL) "kind" "page") -}}
{{- end -}}
{{- range where .Site.RegularPages "Section" "posts" -}}
  {{- $list = $list | append (dict "title" .Title "url" .RelPermalink "kind" "post") -}}
{{- end -}}
{{- range where .Site.RegularPages "Section" "mirana" -}}
  {{- $list = $list | append (dict "title" .Title "url" .RelPermalink "kind" "log") -}}
{{- end -}}
{{- $list | jsonify -}}
